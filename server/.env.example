# Copie este arquivo para .env e preencha. NUNCA suba o .env para o GitHub.
PORT=3001

# Origens permitidas para chamar a API (separe por vírgula). Ex.: https://www.abimaeldev.eng.br
CORS_ORIGIN=http://localhost:5173

# --- Envio de e-mail (opcional) ---
# Sem SMTP configurado, as mensagens do formulário são salvas em server/data/messages.json
# Gmail: use uma "Senha de app" (https://myaccount.google.com/apppasswords), não sua senha normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO=abimaeldevfull.stack@gmail.com
